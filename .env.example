# ============================================================
#  Olla English CRM — șablon de configurare
#  Copiază în `.env` și completează. Vezi README pentru detalii.
# ============================================================

# ── OBLIGATORII ─────────────────────────────────────────────

# MongoDB — numele bazei trebuie inclus în URL (Prisma îl cere)
DATABASE_URL="mongodb+srv://USER:PAROLA@cluster.mongodb.net/ollaenglish?retryWrites=true&w=majority"

NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET=""

# 64 caractere hex — node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=""

# ── RECOMANDATE ─────────────────────────────────────────────

# Protejează /api/cron/*
CRON_SECRET=""

TOTP_APP_NAME="Olla English"
SESSION_EXPIRATION_HOURS="8"
STEP_UP_TOKEN_EXPIRATION="300"

# ── TELEGRAM (opțional) ─────────────────────────────────────
# Un singur bot poate acoperi toate rolurile. Grupul trebuie să aibă Topics activate,
# iar botul să fie admin cu „Manage topics" pentru `node scripts/setup-telegram-topics.mjs`.
TELEGRAM_LESSONS_BOT_TOKEN=""
TELEGRAM_CONTACT_BOT_TOKEN=""
TELEGRAM_SECURITY_BOT_TOKEN=""

TELEGRAM_ADMIN_CHAT_ID=""
TELEGRAM_LESSONS_CHAT_ID=""
TELEGRAM_CONTACT_CHAT_ID=""
TELEGRAM_SECURITY_CHAT_ID=""

TELEGRAM_WEBHOOK_SECRET=""

# Username-ul botului (fără @) — pentru linkul de conectare a conturilor la Telegram
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME="olla_english_bot"

# Completate automat de scripts/setup-telegram-topics.mjs
TELEGRAM_MISSED_LESSONS_THREAD_ID=""
TELEGRAM_LOW_LESSONS_THREAD_ID=""
TELEGRAM_PAYMENTS_THREAD_ID=""
TELEGRAM_CONTACT_THREAD_ID=""
TELEGRAM_ENROLLMENTS_THREAD_ID=""
TELEGRAM_TEACHER_ACTIVITIES_THREAD_ID=""
TELEGRAM_SECURITY_THREAD_ID=""

# ── OPȚIONALE ───────────────────────────────────────────────

# CAPTCHA la login (Cloudflare Turnstile)
CAPTCHA_PROVIDER="turnstile"
TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
CAPTCHA_FAILURE_THRESHOLD="3"
CAPTCHA_RESET_HOURS="24"

# Upload imagini (Vercel Blob)
BLOB_READ_WRITE_TOKEN=""

# Corectare AI în portalul elevului (Mr. Olla)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
AI_GRADING_ENABLED="true"
AI_LIMIT_STUDENT_DAILY="20"
AI_LIMIT_IP_HOURLY="60"
AI_BUDGET_DAILY_USD="5"

# Rate limiting distribuit (fallback automat pe MongoDB)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Tuning
AUDIT_LOG_RETENTION_DAYS="90"
ARGON2_MEMORY_COST="19456"
ARGON2_TIME_COST="2"
ARGON2_PARALLELISM="1"

# Conturi inițiale pentru `npm run db:seed`
SEED_ADMIN_EMAIL="admin@ollaenglish.md"
SEED_ADMIN_PASSWORD=""
SEED_TEACHER_EMAIL="profesor@ollaenglish.md"
SEED_TEACHER_PASSWORD=""
